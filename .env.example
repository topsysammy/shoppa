# Supabase project settings (Project Settings > API). Only the public anon key
# belongs in the browser; never put the service role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# A2: Continue with Apple is P2. Set to "true" once Apple sign-in is configured.
VITE_ENABLE_APPLE=false
# N4 Web Push: public VAPID key (npx web-push generate-vapid-keys). The private key
# goes only in Supabase Edge Function secrets, never here.
VITE_VAPID_PUBLIC_KEY=
